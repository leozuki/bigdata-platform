# ============================================================
# BDS Data Pipeline - Environment Configuration
# Copy file này thành .env và điền giá trị thực
# ============================================================

# --- DATABASE ---
DATABASE_URL=sqlite:///d:/BigData/data/bigdata.db
# PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost:5432/bigdata
# BigQuery:   DATABASE_URL=bigquery://your-project/your_dataset

# --- GOOGLE SEARCH API ---
# Lấy tại: https://console.cloud.google.com/apis/library/customsearch.googleapis.com
# Tạo CSE tại: https://programmablesearchengine.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# Query tìm kiếm, phân cách bằng dấu phẩy
GOOGLE_SEARCH_QUERIES=bán đất nền Hà Nội,bán căn hộ TP.HCM,cần bán đất tỉnh,bảng giá dự án,cọc thiện chí bds

# Số trang kết quả Google tối đa mỗi query (1 page = 10 kết quả)
GOOGLE_MAX_PAGES=5

# Delay giữa các request (giây) để tránh bị block
GOOGLE_REQUEST_DELAY=1.5

# --- PATHS ---
RAW_DATA_DIR=d:/BigData/data/raw
PROCESSED_DATA_DIR=d:/BigData/data/processed

# ============================================================
# ADS ENGINE — Facebook Marketing API + Messenger API
# ============================================================

# Lấy tại: https://developers.facebook.com → App Dashboard
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Long-lived User Access Token (permissions: ads_management, ads_read, pages_messaging, pages_read_engagement)
# Lấy tại: https://developers.facebook.com/tools/explorer/
META_ACCESS_TOKEN=your_long_lived_access_token

# Ad Account ID — format: act_xxxxxxxxxx
META_AD_ACCOUNT_ID=act_000000000000

# Page ID của Fanpage (dùng cho Messenger API)
META_PAGE_ID=your_facebook_page_id

# API Version (thay đổi theo phiên bản mới nhất của Meta)
META_API_VERSION=v20.0

# --- ADS OPTIMIZER SETTINGS ---
# true  = chỉ preview actions, không gọi API thực (AN TOÀN)
# false = apply actions thực sự (cần xác nhận trên dashboard)
ADS_DRY_RUN=true

# Buộc dùng mock data (hữu ích khi test mà không có API key)
ADS_MOCK_MODE=true

# Khoảng cách giữa các lần tự động chạy optimizer (giờ)
ADS_SYNC_INTERVAL_HOURS=6

# --- OPTIMIZATION RULE THRESHOLDS (VND) ---
# Override các ngưỡng mặc định nếu cần
RULE_PAUSE_CPL=500000
RULE_SCALE_CPL=150000
RULE_PAUSE_QUALITY=4.0
RULE_SCALE_QUALITY=7.0
RULE_SCALE_FACTOR=1.5
RULE_CTR_POOR=1.0
RULE_FREQ_CAP=3.5
RULE_WINNER_QUALITY=8.0
RULE_WINNER_BUDGET=2.0

# --- COST BENCHMARK THRESHOLDS (ngành BĐS Việt Nam) ---
BENCH_CPL_GOOD=150000
BENCH_CPL_MEDIUM=400000
BENCH_CPM_GOOD=50000
BENCH_CPM_MEDIUM=100000
BENCH_CTR_GOOD=2.0
BENCH_CTR_MEDIUM=1.0
BENCH_FREQ_GOOD=2.5
BENCH_FREQ_MEDIUM=3.5
BENCH_CONV_GOOD=8.0
BENCH_CONV_MEDIUM=4.0

